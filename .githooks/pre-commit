#!/bin/sh
#
# 구현 작업자 라우팅 가드 — staged 경로를 검사한다.
#
# 설치: npm run agent-routing:install
#   공유 저장소의 core.hooksPath를 주 worktree의 절대 .githooks 경로로 맞춘다.
#   Git worktree는 저장소 설정을 공유하므로 기존·새 worktree가 모두 이 훅을 쓴다.
#
# 검증기는 항상 주 worktree에서 가져온다. 자식 worktree가 오래된 브랜치를 보고 있어도
# 최신 정책이 적용된다.

primary=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
if [ -z "$primary" ]; then
  exit 0
fi

verifier="$primary/scripts/verify-agent-routing.mjs"
if [ ! -f "$verifier" ]; then
  echo "[agent-routing] 검증기를 찾을 수 없어 검사를 건너뛴다: $verifier" >&2
  exit 0
fi

exec node "$verifier" --staged
