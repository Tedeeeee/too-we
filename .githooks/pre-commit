#!/bin/sh
#
# 구현 작업자 라우팅 가드 — staged 경로를 검사한다.
#
# 설치: npm run agent-routing:install
#   이 파일은 템플릿이다. 설치 스크립트가 <git-common-dir>/orca-routing-hooks/로 복사하고
#   core.hooksPath를 그 절대 경로로 맞춘다. 실행되는 것은 작업 트리 밖의 사본이므로
#   `git rm .githooks/pre-commit` 한 커밋으로 훅을 없앨 수 없다.
#
# 검증기는 주 worktree에서 가져온다. 자식 worktree가 오래된 브랜치를 보고 있어도 최신
# 정책이 적용된다.
#
# 주 worktree나 검증기를 찾지 못하면 통과시키지 않고 exit 1 한다. 가드가 조용히 열리는
# 것보다 커밋이 시끄럽게 막히는 쪽이 안전하다 — 검증기를 지우거나 옮겨서 가드를 무력화하는
# 경로를 이 선택이 막는다. 복구는 파일을 되돌리거나 `npm run agent-routing:install`이다.

primary=$(git worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p')
if [ -z "$primary" ]; then
  echo "[agent-routing] 주 worktree를 확인할 수 없어 커밋을 막는다." >&2
  exit 1
fi

verifier="$primary/scripts/verify-agent-routing.mjs"
if [ ! -f "$verifier" ]; then
  echo "[agent-routing] 검증기가 없어 커밋을 막는다: $verifier" >&2
  echo "[agent-routing] 파일을 되돌리거나 npm run agent-routing:install 을 실행한다." >&2
  exit 1
fi

exec node "$verifier" --staged
